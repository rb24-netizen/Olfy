          },
          "403": {
            "description": "Invalid token or origin"
          }
        }
      }
    },
    "/api/v1/practice": {
      "post": {
        "operationId": "post_practice",
        "summary": "Exercise the full software pipeline in a disposable generated dataset; existing recordings and models are untouched",
        "security": [
          {
            "LocalToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Practice"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request or unavailable sensor"
          },
          "403": {
            "description": "Invalid token or origin"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Reading": {
        "type": "object",
        "required": [
          "gas_ohm",
          "schema_version"
        ],
        "properties": {
          "gas_ohm": {
            "type": "number",
            "description": "Unit: ohm",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "temperature_c": {
            "type": "number",
            "description": "Unit: degC"
          },
          "humidity_pct": {
            "type": "number",
            "description": "Unit: %RH"
          },
          "pressure_hpa": {
            "type": "number",
            "description": "Unit: hPa"
          },
          "heater_c": {
            "type": "number",
            "description": "Unit: degC"
          },
          "heater_ms": {
            "type": "number",
            "description": "Unit: ms"
          },
          "schema_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "source_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "extra_channels": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      },
      "FirmwarePacket": {
        "type": "object",
        "required": [
          "type",
          "schema_version",
          "device_id",
          "profile",
          "gas_ohm",
          "source_sequence"
        ],
        "properties": {
          "gas_ohm": {
            "type": "number",
            "description": "Unit: ohm",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "temperature_c": {
            "type": "number",
            "description": "Unit: degC"
          },
          "humidity_pct": {
            "type": "number",
            "description": "Unit: %RH"
          },
          "pressure_hpa": {
            "type": "number",
            "description": "Unit: hPa"
          },
          "heater_c": {
            "type": "number",
            "description": "Unit: degC"
          },
          "heater_ms": {
            "type": "number",
            "description": "Unit: ms"
          },
          "schema_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "source_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "extra_channels": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "olfy.sample"
            ]
          },
          "device_id": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "real",
              "simulation"
            ]
          },
          "units": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "StartScan": {
        "type": "object",
        "required": [
          "group_id"
        ],
        "anyOf": [
          {
            "required": [
              "label"
            ]
          },
          {
            "required": [
              "fragrance_id"
            ]
          }
        ],
        "properties": {
          "fragrance_id": {
            "type": "string",
            "maxLength": 120,
            "description": "Optional reference catalogue ID. Real known reference scans only; the server fills the canonical label. Not accepted for simulation or quick captures."
          },
          "label": {
            "type": "string",
            "maxLength": 120
          },
          "group_id": {
            "type": "string",
            "maxLength": 120
          },
          "bottle_id": {
            "type": "string",
            "maxLength": 120
          },
          "sample_id": {
            "type": "string",
            "maxLength": 120
          },
          "device_id": {
            "type": "string",
            "maxLength": 120
          },
          "substrate": {
            "type": "string",
            "maxLength": 120
          },
          "dose": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulation",
              "real"
            ],
            "default": "simulation"
          },
          "kind": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "blank"
            ],
            "default": "known"
          },
          "drydown_min": {
            "type": "number",
            "minimum": 0,
            "maximum": 10080
          },
          "warmup_ack": {
            "type": "boolean"
          }
        }
      },
      "StartCapture": {
        "type": "object",
        "required": [
          "mode",
          "label",
          "group_id",
          "bottle_id",
          "warmup_ack"
        ],
        "properties": {
          "fragrance_id": {
            "type": "string",
            "maxLength": 120,
            "description": "Optional reference catalogue ID. Real known reference scans only; the server fills the canonical label. Not accepted for simulation or quick captures."
          },
          "label": {
            "type": "string",
            "maxLength": 120
          },
          "group_id": {
            "type": "string",
            "maxLength": 120
          },
          "bottle_id": {
            "type": "string",
            "maxLength": 120
          },
          "sample_id": {
            "type": "string",
            "maxLength": 120
          },
          "device_id": {
            "type": "string",
            "maxLength": 120
          },
          "substrate": {
            "type": "string",
            "maxLength": 120
          },
          "dose": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 1000
          },
          "mode": {
            "type": "string",
            "enum": [
              "real"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
